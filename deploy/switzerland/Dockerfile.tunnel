FROM alpine:3.22
RUN apk add --no-cache openssh-client
RUN adduser -D -u 1000 tunnel
USER tunnel
ENTRYPOINT ["/bin/sh", "-ec"]
CMD ["umask 077; printf '%s\n' \"$NVIDIA_SSH_KEY\" > /tmp/key; printf '%s\n' \"$NVIDIA_KNOWN_HOSTS\" > /tmp/known_hosts; exec ssh -N -i /tmp/key -o IdentitiesOnly=yes -o BatchMode=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/tmp/known_hosts -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -L 0.0.0.0:4319:127.0.0.1:30081 -L 0.0.0.0:4320:127.0.0.1:30082 -L 0.0.0.0:4321:127.0.0.1:8017 -p 12516 nvidia@global.prd.ga.launchpad.nvidia.com"]
